# Copia questo file in ".env" (o imposta le variabili direttamente nel
# sistema/nel task di Windows) e riempi i valori.
# NON committare mai il file ".env" reale in un repository pubblico.

# Chiave API Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Bot Telegram: crealo parlando con @BotFather su Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID del canale/gruppo privato a cui inviare l'audio.
# Per ottenerlo: aggiungi il bot al canale come admin, invia un messaggio nel
# canale, poi apri https://api.telegram.org/bot<TOKEN>/getUpdates nel browser
# e cerca il campo "chat":{"id": ...} (di solito un numero negativo per i canali).
TELEGRAM_CHAT_ID=-1001234567890
# opzionale: chat per gli avvisi di errore (altrimenti TELEGRAM_CHAT_ID)
TELEGRAM_ADMIN_CHAT_ID=
# opzionale, default spento: rimanda l'MP3 come file oltre al link
TELEGRAM_INVIA_AUDIO=
# sito: URL base pubblico (es. https://rassegna-audio.pages.dev) e token nel percorso
# (se SITO_TOKEN è vuoto viene generato in data/sito_token.txt)
SITO_BASE_URL=
SITO_TOKEN=
# deploy su Cloudflare Pages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=rassegna-audio
# obbligatoria per mappa e immagini: Wikimedia e Nominatim chiedono un contatto nello user agent
# (senza, queste chiamate vengono saltate e restano solo cache e poligoni locali)
CONTATTO_EMAIL=
